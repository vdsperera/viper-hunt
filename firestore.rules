rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Read-only configurations.
    match /configs/{configId} {
      allow read: if true;
      allow write: if false; // Must be updated via Firebase Console or Admin SDK
    }
    
    // Players can save high scores, but only to their own UID document
    match /profiles/{userId} {
      allow read: if true; // Public leaderboard
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.data.name is string 
                   && request.resource.data.highScore is number;
    }
  }
}
